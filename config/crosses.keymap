#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define COLEMAK 0
#define QWERTY 1
#define MOUSE_NAV 2
#define PUNC_NUMS 3
#define FN_KEYS 4
#define MODIFIERS 5
#define DYN_MOUSE 7

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        caps_word: caps_word {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS_WORD";
            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
            continue-list = <UNDERSCORE MINUS>;
        };

        hmrw: hold_tap_home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_HOME_ROW_MODS";
            bindings = <&as>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <10 11 12 13 16 17 18 19 14 15>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_mods {
            bindings = <&sl MODIFIERS>;
            key-positions = <30 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak {
            display-name = "Colemak";
            bindings = <
&as LS(Q) Q  &as LS(W) W  &as LS(F) F    &as LS(P) P  &as LS(B) B    &as LS(J) J  &as LS(L) L  &as LS(U) U          &as LS(Y) Y            &as LS(SEMICOLON) SEMICOLON
&as LS(A) A  &as LS(R) R  &as LS(S) S    &as LS(T) T  &as LS(G) G    &as LS(M) M  &as LS(N) N  &as LS(E) E          &as LS(I) I            &as LS(O) O
&as LS(X) X  &as LS(C) C  &as LS(D) D    &as LS(V) V  &as LS(Z) Z    &as LS(K) K  &as LS(H) H  &as LS(COMMA) COMMA  &as LS(PERIOD) PERIOD  &as LS(SLASH) SLASH
                          &mo MOUSE_NAV  &kp SPACE    &kp BACKSPACE  &kp TAB      &kp RET      &mo PUNC_NUMS
            >;
        };

        qwerty {
            display-name = "Qwerty";
            bindings = <
&kp Q  &kp W  &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I      &kp O    &kp P
&kp A  &kp S  &kp D   &kp F   &kp G   &kp H   &kp J   &kp K      &kp L    &kp SEMI
&kp Z  &kp X  &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH
              &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            display-name = "Mouse+Nav";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &kp HOME  &kp UP    &kp END    &kp PAGE_UP
&tog QWERTY   &mkp RCLK     &mkp MCLK     &mkp LCLK     &trans        &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN
&trans        &trans        &trans        &trans        &trans        &trans  &trans    &trans    &trans     &trans
                            &trans        &trans        &trans        &trans  &trans    &trans
            >;
        };

        punctuation_and_numbers {
            display-name = "Punc+Nums";
            bindings = <
&trans    &trans                          &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(UNDER)  &kp ASTRK               &as AMPS N7    &as ASTRK N8    &as LPAR N9   &as EQUAL PLUS
&trans    &as DOUBLE_QUOTES SINGLE_QUOTE  &kp LS(LPAR)  &kp LS(RPAR)  &kp EQUAL      &kp DOT                 &as DOLLAR N4  &as PERCENT N5  &as CARET N6  &as RPAR N0
&kp CAPS  &as GRAVE TILDE                 &kp LBKT      &kp RBKT      &kp BSLH       &as BACKSLASH KP_SLASH  &as EXCL N1    &as AT N2       &as POUND N3  &as UNDER MINUS
                                          &kp ESC       &trans        &trans         &trans                  &mo FN_KEYS    &trans
            >;
        };

        fn_keys {
            display-name = "fn_keys";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod_keys {
            display-name = "modifiers";
            bindings = <
&trans    &trans    &trans     &trans      &trans     &trans     &trans      &trans     &trans    &trans
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &kp K_APP  &kp K_APP  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI
&trans    &trans    &trans     &trans      &trans     &trans     &trans      &trans     &trans    &trans
                    &trans     &trans      &trans     &trans     &trans      &trans
            >;
        };

        dyn_mouse {
            display-name = "dyn_mouse";
            bindings = <
&trans  &trans  &trans       &trans  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans       &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &msc SCRL_UP
&trans  &trans  &trans       &trans  &trans  &trans  &trans     &trans     &trans     &msc SCRL_DOWN
                &to COLEMAK  &trans  &trans  &trans  &trans     &trans
            >;
        };
    };
};
